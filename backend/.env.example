# ==========================================
# Research Reader - Environment Variables
# ==========================================

# 1) Local SQLite (default if omitted):
DATABASE_URL=sqlite:///./storage/reader.db

# 2) Supabase / Cloud PostgreSQL (uncomment and replace with your Supabase URI):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# JWT Secret Key (change to a random string in production)
SECRET_KEY=research-reader-super-secret-key-change-in-prod-2026

# Optional extra CORS allowed origins (comma separated)
# CORS_ORIGINS=https://research-reader-psi.vercel.app
